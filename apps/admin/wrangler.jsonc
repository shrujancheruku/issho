// The admin SPA as a static-assets-only Worker (no Worker code): Vite builds
// into dist/, and `pnpm run deploy` uploads it. See README.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "issho-admin",
  "compatibility_date": "2026-10-23",
  // admin.joinissho.com (Cloudflare creates its DNS record). The workers.dev
  // address is switched off: the custom domain is the only way in.
  "workers_dev": false,
  "routes": [{ "pattern": "admin.joinissho.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html, so a reload on any route works.
    "not_found_handling": "single-page-application"
  }
}
