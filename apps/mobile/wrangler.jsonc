// The app's web build as a static-assets-only Worker (no Worker code):
// `expo export -p web` writes dist/ ("output": "single"), and
// `pnpm run deploy:web` uploads it. Not a public release yet (see
// issue #354, Web release).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "issho-web",
  "compatibility_date": "2026-10-23",
  // app.joinissho.com (Cloudflare creates its DNS record). The workers.dev
  // address is switched off: the custom domain is the only way in.
  "workers_dev": false,
  "routes": [{ "pattern": "app.joinissho.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Expo Router routes are client-side: unknown paths get index.html.
    "not_found_handling": "single-page-application"
  }
}
