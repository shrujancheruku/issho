# All EXPO_PUBLIC_* values are bundled into the app and are PUBLIC. Never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8080
# From `supabase status` (API_URL and PUBLISHABLE_KEY). The publishable key is public by design.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
