# Backend
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
# Direct/session connection for the River worker (LISTEN/NOTIFY)
WORKER_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
SUPABASE_URL=http://127.0.0.1:54321
# Server-only Supabase secret key (sb_secret_...) for admin calls such as account deletion.
# Local: copy SECRET_KEY from `supabase status`. NEVER commit a real value; leave this empty here.
SUPABASE_SECRET_KEY=
API_ADDR=:8080
GOOGLE_MAPS_API_KEY=
# Server-only key restricted to the Cloud Translation API, used with TRANSLATOR=google.
GOOGLE_TRANSLATE_API_KEY=
# Machine translator: gemini (default, the Agent Platform key below) or google (the key above).
TRANSLATOR=
# Agent Platform key: machine translation (the default translator), interest suggestions (API) and composing walks (worker, with the Maps key). Empty = all off.
GOOGLE_GEMINI_API_KEY=
# Worker: Expo access token for push notifications, only if the Expo project
# enables enhanced push security. Empty = send without one.
EXPO_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# Comma-separated browser origins allowed to call the API (admin SPA). Empty = none.
ALLOWED_ORIGINS=
# Error reporting (Sentry). Empty = off. SENTRY_ENVIRONMENT defaults to development.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Share of API requests traced, 0 to 1 (default 1).
SENTRY_TRACES_SAMPLE_RATE=
