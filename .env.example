# Backend
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
# Direct/session connection for the River worker (LISTEN/NOTIFY)
WORKER_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
SUPABASE_URL=http://127.0.0.1:54321
# Server-only Supabase secret key (sb_secret_...) for admin calls such as account deletion.
# Local: copy SECRET_KEY from `supabase status`. NEVER commit a real value; leave this empty here.
SUPABASE_SECRET_KEY=
API_ADDR=:8080
GOOGLE_MAPS_API_KEY=
# Server-only key restricted to the Cloud Translation API (on-demand translation). Empty = off.
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_API_KEY=
# Comma-separated browser origins allowed to call the API (admin SPA). Empty = none.
ALLOWED_ORIGINS=
