// Renovate config. Renovate runs on main; its Dependency Dashboard is the issue it keeps up to date.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Pins every `uses:` to a commit SHA with a version comment. Third-party actions
    // run next to the deploy's Workload Identity Federation sign-in and `packages: write`.
    "helpers:pinGitHubActionDigests",
    // `chore(deps): …` / `fix(deps): …`, which commitlint accepts (scope `deps`).
    ":semanticCommits",
    ":dependencyDashboard",
  ],
  timezone: "Europe/London",
  schedule: ["before 7am on monday"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 7am on the first day of the month"],
    automerge: false,
  },
  // Automerge waits for the required checks: `ignoreTests` is false (Renovate's default),
  // and the `main` ruleset (strict) enforces them. Platform automerge needs the repo's
  // "Allow auto-merge" setting, an owner step.
  ignoreTests: false,
  // Same release-age gate as pnpm-workspace.yaml (1440 minutes = 1 day), so Renovate
  // never opens a PR for a version pnpm would refuse to install.
  minimumReleaseAge: "1 day",
  prConcurrentLimit: 5,
  // The boundaries check's fixtures are small Go modules under testdata/. They are not
  // dependencies of the repo, so they are not scanned.
  ignorePaths: ["**/node_modules/**", "**/testdata/**"],
  // gomod covers backend/go.mod (the runtime dependencies) and tools/go.mod (the build-only
  // `tool` directives: buf, sqlc, goose, gitleaks, actionlint, protoc-gen-go and -connect-go).
  // go.work is kept and go.work.sum is committed.
  postUpdateOptions: ["gomodTidy"],
  packageRules: [
    {
      // Runtime dependencies bump the patch version through release-please (`fix(deps)`).
      // Deliberately not `indirect` (gomod's depType for `// indirect` requires): Go records
      // the build-only tools' own dependencies there too, so Renovate can't tell them from
      // runtime ones. `go mod why -m` shows ulikunitz/xz, rardecode and mholt/archives are
      // reached only through gitleaks, and `go list -deps ./cmd/...` includes none of them.
      // Indirect bumps stay `chore(deps)` rather than cutting a release for a tool.
      matchDepTypes: ["dependencies", "require"],
      semanticCommitType: "fix",
    },
    {
      // Dev tooling releases nothing (`chore(deps)`).
      matchDepTypes: ["devDependencies"],
      semanticCommitType: "chore",
    },
    {
      // Patch and minor updates automerge once the required checks pass, for every manager
      // here: npm, Go modules, GitHub Actions and Docker images. Majors are excluded below.
      // Later rules override this one, so the exceptions come after it.
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
    },
    {
      // A major update waits for a person and a ticket. The label is what the reviewer
      // filters on: a major upgrade gets a ticket within a week (the hygiene bar, #414).
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["major-update"],
    },
    {
      // The build-only `tool` dependencies in tools/go.mod (codegen, migrations, secrets
      // scan, workflow lint). connect and protobuf are also runtime libraries, so they are
      // not listed. Only the commit type is set here: their automerge comes from the
      // patch/minor rule.
      matchManagers: ["gomod"],
      matchPackageNames: [
        "github.com/bufbuild/buf",
        "github.com/pressly/goose/v3",
        "github.com/rhysd/actionlint",
        "github.com/sqlc-dev/sqlc",
        "github.com/zricethezav/gitleaks/v8",
      ],
      semanticCommitType: "chore",
    },
    {
      // gitleaks (a build-only `tool`) pulls in mholt/archives, which must be built against
      // a matching rardecode: rardecode 2.2.0 with archives 0.1.2 fails `make secrets-scan`
      // ("*rardecode.ReadCloser does not implement rarReader (missing method WriteTo)"),
      // while archives 0.1.5 requires rardecode 2.2.0. Gitleaks 8.30.1 (latest) still pins
      // archives 0.1.2, so one PR raises both. This only groups ordinary updates:
      // vulnerabilityAlerts defaults to `groupName: null`, so security PRs are never
      // grouped. Drop this rule once gitleaks requires archives >= 0.1.5.
      groupName: "go archives",
      matchManagers: ["gomod"],
      matchPackageNames: ["github.com/mholt/archives", "github.com/nwaples/rardecode/v2"],
    },
    {
      // The member app lints through eslint-config-expo, whose eslint-plugin-react fails
      // to load on ESLint 10 ("contextOrFilename.getFilename is not a function"), so
      // apps/app stays on 9 while the admin moves on. Drop this rule once an Expo SDK's
      // eslint-config-expo supports ESLint 10.
      matchFileNames: ["apps/app/package.json"],
      matchPackageNames: ["eslint", "@eslint/js"],
      allowedVersions: "<10",
    },
    {
      // The app's native runtime never automerges, whatever the update type. CI bundles the
      // app for iOS and Android (`native-bundle`), but no device build runs in CI, so a
      // native-runtime break can pass CI. Expo moves as one SDK: `expo install --fix` picks
      // the versions each SDK expects, which Renovate can't, so a person aligns them. React
      // and react-dom are pinned to the React Native release. They're grouped into one PR a
      // week, the global schedule.
      // Keep this rule LAST: later packageRules win, and an earlier position would let
      // the patch/minor automerge rule override `automerge: false`.
      groupName: "app native",
      matchPackageNames: [
        "expo",
        "expo-*",
        "@expo/*",
        "jest-expo",
        "eslint-config-expo",
        "react-native",
        "react-native-*",
        "@react-native/*",
        "@react-native-*",
        "@sentry/react-native",
        "react",
        "react-dom",
      ],
      automerge: false,
      prBodyNotes: [
        "Align the SDK-pinned packages before merging: from `apps/app` run `npx expo install --fix` and `npx expo-doctor`, and commit the result. Read the versioned Expo docs; don't rely on memory.",
      ],
    },
  ],
  customManagers: [
    {
      // config/kamal-version holds the Kamal release alone (a bare version). CI installs it
      // with `gem install kamal` and the config test runs the matching image.
      customType: "regex",
      managerFilePatterns: ["/^config/kamal-version$/"],
      matchStrings: ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      depNameTemplate: "kamal",
      datasourceTemplate: "rubygems",
    },
    {
      // The Postgres image the backend's tests start (testcontainers, in Go code, which the
      // dockerfile manager can't see). Its major bumps need a person (the major rule).
      customType: "regex",
      managerFilePatterns: ["/^backend\\/internal\\/testdb\\/testdb\\.go$/"],
      matchStrings: ["\"(?<depName>postgres):(?<currentValue>\\d+(?:\\.\\d+)?)-alpine\""],
      datasourceTemplate: "docker",
      versioningTemplate: "loose",
    },
  ],
}
