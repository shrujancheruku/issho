// The marketing page (this folder, as is) as a static-assets-only Worker at
// joinissho.com and www.joinissho.com. Deploy: `pnpm -C apps/admin exec wrangler deploy -c ../../site/wrangler.jsonc` from the repo root.
{
  "name": "issho-site",
  "compatibility_date": "2026-10-26",
  // The workers.dev address is switched off; the custom domains are the only way in.
  "workers_dev": false,
  "assets": { "directory": "." },
  "routes": [
    { "pattern": "joinissho.com", "custom_domain": true },
    { "pattern": "www.joinissho.com", "custom_domain": true }
  ]
}
