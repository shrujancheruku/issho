{
  "tracker": "github",
  "github_repo": "shrujancheruku/issho",
  "labels": {
    "size": {
      "S": "size:S",
      "M": "size:M",
      "L": "size:L"
    },
    "risk": "risk",
    "integrated": "integrated"
  },
  "risk_paths": [
    "backend/db/migrations/**",
    "backend/internal/policy/**",
    "backend/internal/matching/**",
    "backend/internal/safety/**",
    "backend/internal/retention/**",
    "backend/internal/rpc/**",
    "proto/**",
    "config/**",
    ".kamal/**",
    ".github/workflows/deploy-*.yml",
    ".github/workflows/ci.yml",
    "backend/Dockerfile",
    "supabase/config.toml",
    "apps/*/wrangler.jsonc"
  ],
  "models": {
    "haiku": "haiku",
    "sonnet": "sonnet",
    "opus": "opus"
  },
  "slack_prefix": "issho",
  "generated_paths": [
    "backend/gen/**",
    "packages/api-client/src/gen/**",
    "pnpm-lock.yaml",
    "backend/go.sum"
  ]
}
