# Copy to .kamal/secrets (gitignored) and keep it free of literal values:
# each line reads the value from the gitignored production env file (or
# your shell), so the secrets themselves stay in one place.
# Kamal runs the $(...) commands locally on every deploy.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

DATABASE_URL=$(sed -n 's/^DATABASE_URL=//p' .env.issho-prod)
SUPABASE_SECRET_KEY=$(sed -n 's/^SUPABASE_SECRET_KEY=//p' .env.issho-prod)
GOOGLE_MAPS_API_KEY=$(sed -n 's/^GOOGLE_MAPS_API_KEY=//p' .env.issho-prod)
GOOGLE_TRANSLATE_API_KEY=$(sed -n 's/^GOOGLE_TRANSLATE_API_KEY=//p' .env.issho-prod)
GOOGLE_GEMINI_API_KEY=$(sed -n 's/^GOOGLE_GEMINI_API_KEY=//p' .env.issho-prod)
GITHUB_TOKEN=$(sed -n 's/^GITHUB_TOKEN=//p' .env.issho-prod)
SENTRY_DSN=$(sed -n 's/^SENTRY_DSN=//p' .env.issho-prod)
EXPO_ACCESS_TOKEN=$(sed -n 's/^EXPO_ACCESS_TOKEN=//p' .env.issho-prod)

# The Cloudflare origin certificate and its key (SSL/TLS → Origin Server in
# the Cloudflare dashboard), saved outside the repository.
CLOUDFLARE_ORIGIN_CERT=$(cat ~/.config/issho/origin-cert.pem)
CLOUDFLARE_ORIGIN_KEY=$(cat ~/.config/issho/origin-key.pem)
# The backup accessory's R2 token (object read and write on the backup bucket only).
R2_ACCESS_KEY_ID=$(sed -n 's/^R2_ACCESS_KEY_ID=//p' .env.issho-prod)
R2_SECRET_ACCESS_KEY=$(sed -n 's/^R2_SECRET_ACCESS_KEY=//p' .env.issho-prod)
