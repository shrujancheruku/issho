# The secrets of the dev destination: what Kamal reads when it deploys to dev.
# Nothing in this file is a value. Each line names a secret in Google Secret
# Manager (project issho-dev-512213); Kamal reads it with `gcloud`, signed in by
# Workload Identity Federation as the deploy service account, which can only
# access secrets (docs/deploy.md). The two it does not read from there:
#   KAMAL_REGISTRY_PASSWORD  the workflow's own token, given in its environment;
#                            Kamal wants every secret the config names listed here
#   DEPLOY_HOST              not a secret; config/deploy.dev.yml reads it directly

# One line: Kamal's parser does not continue a command over lines.
SECRETS=$(kamal secrets fetch --adapter gcp_secret_manager --account default --from issho-dev-512213 dev-database-url dev-supabase-auth-url dev-worker-database-url dev-resend-api-key dev-email-from dev-ssh-private-key dev-origin-cert dev-origin-key dev-supabase-url dev-supabase-publishable-key)

DATABASE_URL=$(kamal secrets extract dev-database-url ${SECRETS})
SUPABASE_AUTH_URL=$(kamal secrets extract dev-supabase-auth-url ${SECRETS})
WORKER_DATABASE_URL=$(kamal secrets extract dev-worker-database-url ${SECRETS})
RESEND_API_KEY=$(kamal secrets extract dev-resend-api-key ${SECRETS})
EMAIL_FROM=$(kamal secrets extract dev-email-from ${SECRETS})
SSH_PRIVATE_KEY=$(kamal secrets extract dev-ssh-private-key ${SECRETS})
ORIGIN_CERT=$(kamal secrets extract dev-origin-cert ${SECRETS})
ORIGIN_KEY=$(kamal secrets extract dev-origin-key ${SECRETS})
EXPO_PUBLIC_SUPABASE_URL=$(kamal secrets extract dev-supabase-url ${SECRETS})
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$(kamal secrets extract dev-supabase-publishable-key ${SECRETS})
# EXPO_PUBLIC_SUPABASE_URL and ..._PUBLISHABLE_KEY are the web build's sign-in values
# (config/deploy.web.yml, builder secrets). Both are public once bundled; the URL is
# here to keep the project's ref out of the repository.
# SUPABASE_AUTH_URL is public (https://<ref>.supabase.co/auth/v1); it is kept here
# only so the project's ref stays out of this public repository.
# Not here: dev-ssh-host-key, the VM's public host key. scripts/dev-ssh-pin.sh
# reads it with gcloud before Kamal connects and writes it as the one key ssh
# accepts for the VM, so Kamal never needs it.

# Passed through from the environment, the job's own GITHUB_TOKEN.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
